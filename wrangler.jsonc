// RepliPlate on Cloudflare Workers: the app files + the AI proxy (/api/ai.php).
// Secret (Settings → Variables and Secrets): ANTHROPIC_API_KEY.  Optional: MODEL, REQUESTS_PER_HOUR, ALLOWED_ORIGINS
{
  "name": "repliplate-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "observability": { "enabled": true }
}
